<?xml version="1.0"?>

<model>
  <name>orientation_cube_medium</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>DonDron</name>
  </author>

  <description>
    M3 spatial-orientation prop — 0.6 m green cube (primitive geometry, no
    mesh asset). Not a recognition target: purely a visual scale/distance
    reference for manual flight testing (Mode A). YOLO is filtered to COCO
    class 11 ("stop sign") only, so this cube is never detected/published on
    /detections.
  </description>
</model>
