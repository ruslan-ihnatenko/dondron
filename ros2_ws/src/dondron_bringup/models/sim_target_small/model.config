<?xml version="1.0"?>

<model>
  <name>sim_target_small</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>DonDron</name>
  </author>

  <description>
    M3 orientation prop — smaller variant of sim_target (~0.5 m effective
    width vs. ~1.0 m). Same Fuel "Stop Sign" mesh, half the scale. Useful for
    testing YOLO detection/monocular range at a different apparent target
    size without moving the drone. See models/sim_target/model.config for
    material-override rationale.
  </description>
</model>
