<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="sim_target">
    <static>true</static>
    <link name="link">
      <!--
        Upstream mesh measures ~0.095 m across as authored (empirically
        calibrated via a known-distance camera frame, not trustworthy from
        the raw COLLADA transform alone). Scaled 3.2x to match the
        dondron_perception target_width_m default (0.30 m) so no parameter
        override is needed downstream.
      -->
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/stop sign/3/files/meshes/stop_sign.dae</uri>
            <scale>3.2 3.2 3.2</scale>
          </mesh>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/stop sign/3/files/meshes/stop_sign.dae</uri>
            <scale>3.2 3.2 3.2</scale>
          </mesh>
        </geometry>
        <!--
          Override the mesh's embedded legacy Ogre .material script (not
          supported by gz-sim8 / Ogre2 — renders as flat black without this)
          with an SDF PBR material referencing the same cached Fuel texture.
        -->
        <material>
          <ambient>0.75 0.05 0.05 1</ambient>
          <diffuse>0.75 0.05 0.05 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
