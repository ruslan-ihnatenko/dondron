<?xml version="1.0"?>

<model>
  <name>sim_target</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>DonDron</name>
  </author>

  <description>
    M3 sim target — wraps the Fuel "Stop Sign" mesh (OpenRobotics) with a PBR
    material override so it renders correctly under gz-sim8 / Ogre2 (the
    upstream model's legacy Ogre material script is not supported and
    otherwise renders as a flat black silhouette).

    Matches COCO class "stop sign" (id 11) for YOLOv8n pretrained-weight
    detection without custom training. See dondron_perception/README.md and
    docs/dev_state.md for the M3 SIL target configuration
    (target_class_id / target_width_m overrides).
  </description>
</model>
