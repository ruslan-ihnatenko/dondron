<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="sim_target_large">
    <static>true</static>
    <link name="link">
      <!-- Double the scale of models/sim_target (~2.0 m effective width). -->
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/stop sign/3/files/meshes/stop_sign.dae</uri>
            <scale>6.4 6.4 6.4</scale>
          </mesh>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/stop sign/3/files/meshes/stop_sign.dae</uri>
            <scale>6.4 6.4 6.4</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.75 0.05 0.05 1</ambient>
          <diffuse>0.75 0.05 0.05 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
